# Copiar a .env y completar. Nunca subir .env al repositorio.

# Usuario y clave del broker (y del panel http://<host>:15672 / 15673).
# ClassFlowBack debe usar los mismos valores en su .env.
# Generar la clave con: openssl rand -hex 16 (solo letras y numeros, va dentro de la URL AMQP)
RABBITMQ_USER=classflow
RABBITMQ_PASSWORD=cambiar_por_una_clave_aleatoria

# Secreto compartido por los nodos para formar el cluster. Generar con: openssl rand -hex 32
RABBITMQ_ERLANG_COOKIE=cambiar_por_una_clave_aleatoria_de_32_bytes
